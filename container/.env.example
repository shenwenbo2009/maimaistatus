# 构建时烘焙进前端(改后必须 --build)
NUXT_PUBLIC_API_BASE=http://localhost:9560
NUXT_PUBLIC_REPORT_CLIENT_ID=<your-key>
NUXT_PUBLIC_REPORT_PRIVATE_KEY=<your-key>
# Corptcha Site ID(公开信息;须与后端 CORPTCHA_SITE_KEY 同值)
NUXT_PUBLIC_CORPTCHA_SITE_KEY=

# 运行时直读(改后 docker compose up -d 即可)
POLL_INTERVAL_SEC=30
MAINT_WINDOWS=04:00-07:00
CORS_ALLOW=*

# Corptcha 人机验证(可选,两值齐备才启用;Secret 严禁提交仓库)
CORPTCHA_SITE_KEY=
CORPTCHA_SECRET=

# 宿主映射端口(容器内固定 9560/9561)
GATEWAY_HOST_PORT=9560
FRONTEND_HOST_PORT=9561
