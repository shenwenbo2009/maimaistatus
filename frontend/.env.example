NUXT_PUBLIC_API_BASE=http://localhost:9560
# 手动上报签名密钥(Client ID 自定义,私钥发邮件至 qwq@chongxi.us 获取)
NUXT_PUBLIC_REPORT_CLIENT_ID=<your-key>
NUXT_PUBLIC_REPORT_PRIVATE_KEY=<your-key># Corptcha 人机验证 Site ID(公开信息,形如 cpt_xxxxxxxxxxxx;留空=未配置,
# 验证步走本地数字验证码)。构建期烘焙进产物,改值需重新 npm run build。
# 注意:须与后端 CORPTCHA_SITE_KEY 同值,不一致会导致验证始终失败。
NUXT_PUBLIC_CORPTCHA_SITE_KEY=