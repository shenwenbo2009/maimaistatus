@* 上报弹窗(监控页「我要上报」打开;内容与 /report 页共用 ReportWizard)
    Fluent UI 5.x 对话框约定:组件根为 FluentDialogBody,参数经 CascadingParameter IDialogInstance 取回 *@
<FluentDialogBody>
    <TitleTemplate>
        <div class="d-flex align-center gap-2">
            <FluentIcon Value="@(new Icons.Color.Size24.MegaphoneLoud())" Color="Color.Warning" />
            <span style="font-weight:700">我要上报</span>
        </div>
    </TitleTemplate>

    <ChildContent>
        <ReportWizard Done="@CloseAsync" />
    </ChildContent>
</FluentDialogBody>

@code {
    [CascadingParameter] public required IDialogInstance Dialog { get; set; }

    private Task CloseAsync() => Dialog.CancelAsync();
}
