PORT=9560
UPSTREAM_BASE=https://mai.chongxi.us
REPORT_UPSTREAM=https://maiapi.chongxi.us
POLL_INTERVAL_SEC=30
DATA_DIR=./data
HISTORY_MAX=20000
CORS_ALLOW=*

# 华立常规维护窗口(北京时间每日,逗号分隔,支持跨日如 23:30-00:30)
# 维护点位不计入可用率,图表置灰(柱满格灰/线压0灰)
MAINT_WINDOWS=04:00-07:00
# Corptcha 人机验证(可选,默认关闭):两值同时配置才启用,
# 任一缺失时上报验证走本地 8 位数字验证码,行为与不配时完全一致。
# 控制台 https://dash.corptcha.com 站点管理中创建站点获取。
CORPTCHA_SITE_KEY=
# 站点密钥:仅后端运行时使用,严禁提交仓库/写进日志/传给前端。
CORPTCHA_SECRET=
